{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["react", "react-dom", "node", "@playwright/test", "vite/client"],
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@pages/*": ["./e2e/pages/*"],
      "@fixtures/*": ["./e2e/fixtures/*"],
      "@utils/*": ["./e2e/utils/*"],
      "@config/*": ["./e2e/config/*"],
      "@models/*": ["./e2e/models/*"],
      "@api/*": ["./e2e/api/*"],
      "@locators/*": ["./e2e/locators/*"]
    }
  },
  "include": ["src", "server", "e2e", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "test-results", "playwright-report"]
}
